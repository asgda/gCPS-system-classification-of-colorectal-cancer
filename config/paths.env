# Edit the defaults below (or export the variables beforehand), then run: bash run_all.sh
export GCPS_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Inputs (see resources/INPUTS.md)
export GCPS_RAW="${GCPS_RAW:-/path/to/genomics_raw_vcf}"  # short_variants/, vep_output/, cnv/, sv/ from Nunes et al.
export GCPS_REF="${GCPS_REF:-/path/to/reference}"  # cytoBand.txt.gz, genes_protein_coding_hg38.bed
export GCPS_DATA="${GCPS_DATA:-/path/to/nunes_tables}"  # Supplementary_Table_01.xlsx, SBS_signatures.xlsx, Supplementary_Table_29.xlsx,
                                                     # CRC.SW.mRNA.symbol.TPM.txt, CRC.SW.mRNA.symbol.count.txt
export GCPS_CLINICAL="${GCPS_CLINICAL:-$GCPS_DATA/clinical_data.tsv}"
export GCPS_ONCOPREDICT="${GCPS_ONCOPREDICT:-/path/to/oncopredict_inputs}"  # GDSC2_Res.rds, GDSC2_Expr_short.rds, CRC.SW.mRNA.symbol.TPM.txt
export GCPS_TPM="${GCPS_TPM:-$GCPS_DATA/CRC.SW.mRNA.symbol.TPM.txt}"
export GCPS_COUNTS="${GCPS_COUNTS:-$GCPS_DATA/CRC.SW.mRNA.symbol.count.txt}"
export GCPS_NUNES_TABLE29="${GCPS_NUNES_TABLE29:-$GCPS_DATA/Supplementary_Table_29.xlsx}"  # Outputs and compute
export GCPS_OUT="${GCPS_OUT:-$GCPS_ROOT/results}"
export GCPS_JOBS="${GCPS_JOBS:-16}"
export GCPS_SEED="${GCPS_SEED:-42}"  # Interpreters (one environment per row of versions/SOFTWARE_VERSIONS.md)
export GCPS_PYTHON="${GCPS_PYTHON:-python3}"  # steps 01-04, 05-07, 09-16, 18-20, 25, 27, 29-32
export GCPS_PYTHON_TF="${GCPS_PYTHON_TF:-python3}"  # step 28 (TensorFlow / Keras)
export GCPS_TIDEPY="${GCPS_TIDEPY:-tidepy}"  # step 24; "path/to/python path/to/tidepy" if needed
export GCPS_RSCRIPT="${GCPS_RSCRIPT:-Rscript}"
